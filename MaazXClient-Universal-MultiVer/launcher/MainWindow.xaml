<Window x:Class="MaazXLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MaazXClient" Width="1440" Height="900" MinWidth="1120" MinHeight="720"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource Ink}"
        Foreground="{StaticResource Text}" FontFamily="Segoe UI Variable Display, Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid Background="{StaticResource Ink}">
        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="#100C17">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <Border Width="26" Height="26" CornerRadius="6" Background="#8D4DE9" Margin="0,0,9,0">
                    <TextBlock Text="MX" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="MAAZXCLIENT" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="  /  UNIVERSAL" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="−" Width="46" Height="44" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}" Click="Minimize_Click" />
                <Button Content="□" Width="46" Height="44" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}" Click="Maximize_Click" />
                <Button Content="×" Width="46" Height="44" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="232" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#100D17" BorderBrush="#251C30" BorderThickness="0,0,1,0">
                <Grid Margin="18,22,18,18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="YOUR CLIENT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}" />
                        <TextBlock Text="Control room" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <Button x:Name="PlayNav" Content="◈   Play" Tag="Play" Style="{StaticResource NavButton}" Click="Navigate_Click" />
                        <Button x:Name="InstancesNav" Content="▦   Instances" Tag="Instances" Style="{StaticResource NavButton}" Click="Navigate_Click" />
                        <Button x:Name="ModsNav" Content="⌘   Mods" Tag="Mods" Style="{StaticResource NavButton}" Click="Navigate_Click" />
                        <Button x:Name="DownloadsNav" Content="↓   Downloads" Tag="Downloads" Style="{StaticResource NavButton}" Click="Navigate_Click" />
                        <Button x:Name="SettingsNav" Content="⚙   Settings" Tag="Settings" Style="{StaticResource NavButton}" Click="Navigate_Click" />
                    </StackPanel>
                    <Border Grid.Row="4" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#17121F" CornerRadius="8" Padding="13">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Mint}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="CLIENT STATUS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Mint}" />
                            </StackPanel>
                            <TextBlock Text="Ready for setup" FontSize="13" Margin="0,10,0,3" />
                            <TextBlock x:Name="SidebarInstanceText" Text="1 active instance" FontSize="11" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="34,24,34,22">
                <Grid.RowDefinitions><RowDefinition Height="60" /><RowDefinition Height="*" /><RowDefinition Height="36" /></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="Play" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock x:Name="PageSubtitle" Text="Choose an instance and get into your world." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button x:Name="AccountButton" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Content="Sign in with Microsoft" Style="{StaticResource QuietButton}" Click="SignIn_Click" />
                </Grid>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid x:Name="PlayView">
                                <Grid.RowDefinitions><RowDefinition Height="228" /><RowDefinition Height="20" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border Grid.Row="0" CornerRadius="12" BorderBrush="#4C3565" BorderThickness="1" Padding="28">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#271638" Offset="0" /><GradientStop Color="#18111F" Offset="0.62" /><GradientStop Color="#111019" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" MaxWidth="620" HorizontalAlignment="Left">
                                            <Border Background="#3B2353" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                                <TextBlock Text="MAAZX  /  UNIVERSAL CLIENT" FontSize="10" FontWeight="Bold" Foreground="#DCC2FF" />
                                            </Border>
                                            <TextBlock Text="Your worlds.\nYour way." FontSize="38" FontWeight="SemiBold" LineHeight="44" Margin="0,15,0,8" />
                                            <TextBlock Text="One home for your Minecraft versions, instances, and mods." FontSize="14" Foreground="#C2B5D0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#170F21" BorderBrush="#463153" BorderThickness="1" CornerRadius="10" Padding="20" VerticalAlignment="Stretch">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="SESSION PROFILE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}" />
                                                <TextBlock x:Name="HeroInstanceName" Text="Main" FontSize="23" FontWeight="SemiBold" Margin="0,6,0,0" />
                                                <TextBlock x:Name="HeroInstanceInfo" Text="Minecraft 1.21.8  ·  Fabric" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,15" />
                                                <Border Height="1" Background="#392943" />
                                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Mint}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Text="Adaptive tuning enabled" FontSize="12" Foreground="{StaticResource Mint}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="0.9*" /></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="20">
                                        <StackPanel>
                                            <TextBlock Text="PLAY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Violet}" />
                                            <TextBlock Text="Select your session" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,14" />
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="VERSION" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                                                    <ComboBox x:Name="VersionPicker" SelectionChanged="VersionPicker_SelectionChanged" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="INSTANCE" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                                                    <ComboBox x:Name="InstancePicker" DisplayMemberPath="Name" SelectionChanged="InstancePicker_SelectionChanged" />
                                                </StackPanel>
                                            </Grid>
                                            <Button x:Name="LaunchButton" Content="▶   Launch MaazXClient" Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" Margin="0,16,0,0" Click="Launch_Click" />
                                            <ProgressBar x:Name="TaskProgress" Height="3" Minimum="0" Maximum="100" Value="0" Margin="0,14,0,5" Background="#2B2134" Foreground="{StaticResource Mint}" />
                                            <TextBlock x:Name="StatusText" Text="Select an instance to continue." FontSize="11" Foreground="{StaticResource Muted}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#14111A" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="20">
                                        <StackPanel>
                                            <TextBlock Text="INSTALL LOCATION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}" />
                                            <TextBlock x:Name="GamePathSummary" Text="Choose a game directory in Settings" FontSize="13" Margin="0,8,0,14" />
                                            <Border Height="1" Background="{StaticResource Line}" />
                                            <TextBlock Text="RUNTIME" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,14,0,5" />
                                            <TextBlock x:Name="JavaSummary" Text="Checking Java..." FontSize="12" Foreground="{StaticResource Mint}" />
                                            <TextBlock Text="Minecraft files download directly into each instance. Microsoft sign-in is required to play online." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,14,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#14111A" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="16" Margin="0,0,9,0">
                                        <StackPanel>
                                            <TextBlock Text="PERFORMANCE PROFILE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}" />
                                            <TextBlock Text="Adaptive quality · 60 FPS target" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0" />
                                            <TextBlock Text="Reduces load when possible; achieved FPS depends on your system and world." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#14111A" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="16" Margin="9,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="ACTIVE INSTANCE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}" />
                                            <TextBlock x:Name="InstancePathSummary" Text="Instance directory" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" />
                                            <TextBlock Text="Worlds and mods stay isolated by instance." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <Grid x:Name="InstancesView" Visibility="Collapsed">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="INSTANCES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Violet}" />
                                        <TextBlock Text="Separate profiles, worlds, and mods." FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox x:Name="NewInstanceName" Width="190" Height="40" VerticalContentAlignment="Center" Text="New instance" />
                                        <Button Content="＋  Create" Style="{StaticResource ActionButton}" Margin="9,0,0,0" Click="CreateInstance_Click" />
                                        <Button Content="Remove" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="RemoveInstance_Click" />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12">
                                    <ListBox x:Name="InstanceList" Background="Transparent" BorderThickness="0" SelectionChanged="InstanceList_SelectionChanged" />
                                </Border>
                            </Grid>

                            <Grid x:Name="ModsView" Visibility="Collapsed">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="MOD LIBRARY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Violet}" />
                                        <TextBlock Text="Control what loads in the selected instance." FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="＋  Add .jar" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Click="AddMod_Click" />
                                </Grid>
                                <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ModsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="5,7">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Toggle" Tag="{Binding}" Style="{StaticResource QuietButton}" IsEnabled="{Binding IsBuiltIn, Converter={StaticResource InverseBooleanConverter}}" Click="ToggleMod_Click" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>

                            <Grid x:Name="DownloadsView" Visibility="Collapsed">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="VERSION LIBRARY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Violet}" />
                                    <TextBlock Text="Install Minecraft and Fabric into an instance." FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" />
                                </StackPanel>
                                <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14">
                                    <ItemsControl x:Name="VersionList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="5,6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Minecraft" FontSize="13" Foreground="{StaticResource Muted}" />
                                                        <TextBlock FontSize="14" FontWeight="SemiBold"><Run Text="  " /><Run Text="{Binding}" /></TextBlock>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Install to selected instance" Tag="{Binding}" Style="{StaticResource QuietButton}" Click="InstallVersion_Click" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Grid>

                            <Grid x:Name="SettingsView" Visibility="Collapsed">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="PREFERENCES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Violet}" />
                                    <TextBlock Text="Make the setup yours." FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" />
                                </StackPanel>
                                <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="22">
                                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                                        <TextBlock Text="Minecraft directory" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Used as the default parent for managed instances." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,8" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBox x:Name="MinecraftDirectoryBox" Height="40" VerticalContentAlignment="Center" />
                                            <Button Grid.Column="2" Content="Browse" Style="{StaticResource QuietButton}" Click="BrowseDirectory_Click" />
                                        </Grid>
                                        <TextBlock Text="Memory allocation" FontSize="13" FontWeight="SemiBold" Margin="0,22,0,0" />
                                        <TextBlock x:Name="MemoryValue" Text="4 GB" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,4" />
                                        <Slider x:Name="MemorySlider" Minimum="2" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="MemorySlider_Changed" />
                                        <TextBlock Text="Entity render distance" FontSize="13" FontWeight="SemiBold" Margin="0,20,0,0" />
                                        <TextBlock x:Name="EntityDistanceValue" Text="32 blocks" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,4" />
                                        <Slider x:Name="EntityDistanceSlider" Minimum="8" Maximum="128" TickFrequency="8" IsSnapToTickEnabled="True" ValueChanged="EntityDistanceSlider_Changed" />
                                        <CheckBox x:Name="AdaptiveTuningCheckBox" Content="Adaptive quality tuning · 60 FPS target" IsChecked="True" Margin="0,20,0,10" />
                                        <Button Content="Save preferences" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Click="SaveSettings_Click" />
                                        <TextBlock x:Name="JavaPathText" Text="Java runtime: detecting..." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,18,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock x:Name="FooterStatus" Text="MAAZX  /  READY" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    <TextBlock Text="1.20.1 — 1.21.8" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>